{
  "dependencies": {
    "expo": "~54.0.29",
    "expo-dev-client": "~6.0.20",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "^6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "semver": "^7.7.3"
  },
  "devDependencies": {
    "@robinbobin/eslint-config-react-native": "^1.0.1",
    "@robinbobin/prettier-config": "^0.0.5",
    "@robinbobin/ts-config": "^1.0.0",
    "@types/react": "~19.1.0",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{js,json,ts,tsx}": "pnpm prettify"
  },
  "main": "index.ts",
